# ============================================================
# Environment Variables — SOP AI Application
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# OpenAI
OPENAI_API_KEY=your-api-key-here
OPENAI_SOP_MODEL=gpt-4o

# Production Database
SOP_DB_HOST=127.0.0.1
SOP_DB_PORT=3306
SOP_DB_USER=sop_app
SOP_DB_PASSWORD=your-production-db-password
SOP_DB_NAME=sop_ai_app

# Test Database (for running tests locally)
SOP_TEST_DB_PASSWORD=your-test-db-password
SOP_PROD_DB_PASSWORD=your-prod-db-password

# CV Storage (private, outside deployment tree)
SOP_CV_STORAGE=/opt/sop-ai-data/cv

# Auth
SOP_AUTH_SECRET=your-auth-secret
SOP_SESSION_SECRET=your-session-secret

# Build ID (set by CI/CD)
NEXT_PUBLIC_BUILD_ID=local-dev
