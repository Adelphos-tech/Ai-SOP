# ============================================================
# Environment Variables — SOP AI Application
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# OpenAI
OPENAI_API_KEY=your-api-key-here
OPENAI_SOP_MODEL=gpt-4o
# OpenAI-compatible provider override (e.g. Groq testing):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_SOP_MODEL=openai/gpt-oss-120b
# OPENAI_BACKGROUND_RESPONSES_ENABLED=0   # required for non-Responses-API providers

# Production Database
SOP_DB_HOST=127.0.0.1
SOP_DB_PORT=3306
SOP_DB_USER=sop_app
SOP_DB_PASSWORD=your-production-db-password
SOP_DB_NAME=sop_ai_app

# Test Database (for running tests locally)
SOP_TEST_DB_PASSWORD=your-test-db-password
SOP_PROD_DB_PASSWORD=your-prod-db-password

# CV Storage (private, outside deployment tree)
SOP_CV_STORAGE=/opt/sop-ai-data/cv

# CV parser engine: legacy (default, rule-based) | docling (sidecar service)
CV_PARSER_ENGINE=legacy
# Docling sidecar URL — internal only, never public
CV_PARSER_SERVICE_URL=http://127.0.0.1:8099
# Parser service request timeout (docling cold model load can be slow)
CV_PARSER_TIMEOUT_MS=120000
# Optional: fall back to legacy parser if docling service fails (default: off)
CV_PARSER_FALLBACK=

# Auth
SOP_AUTH_SECRET=your-auth-secret
SOP_SESSION_SECRET=your-session-secret

# Build ID (set by CI/CD)
NEXT_PUBLIC_BUILD_ID=local-dev
